     const size_t n = tensor->ne[1];
     const size_t k = tensor->ne[0];

+    if (tensor->type == GGML_TYPE_Q2_0C) {
+        if (!ctx.kernels_q2c || !ctx.kernels_q2c->rhs_info.packed_size_ex) {
+            return ggml_nbytes(tensor);
